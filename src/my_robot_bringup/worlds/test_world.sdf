          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="post4">
        <pose>1.2 0.3 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.08 0.08 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 3.0</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <!-- shelves -->
      <link name="board1">
        <pose>0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.85 0.85 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="board2">
        <pose>0 0 1.4 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.85 0.85 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="board3">
        <pose>0 0 2.3 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.7 0.08</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.85 0.85 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- boxes on shelves -->
      <link name="cargo1">
        <pose>-0.8 0 0.72 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
          <material><ambient>0.55 0.40 0.20 1</ambient><diffuse>0.65 0.48 0.25 1</diffuse></material>
        </visual>
      </link>

      <link name="cargo2">
        <pose>-0.2 0 0.72 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
          <material><ambient>0.55 0.40 0.20 1</ambient><diffuse>0.65 0.48 0.25 1</diffuse></material>
        </visual>
      </link>

      <link name="cargo3">
        <pose>0.5 0 1.62 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
          <material><ambient>0.55 0.40 0.20 1</ambient><diffuse>0.65 0.48 0.25 1</diffuse></material>
        </visual>
      </link>

      <link name="cargo4">
        <pose>0.0 0 2.52 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.28 0.35</size></box></geometry>
          <material><ambient>0.55 0.40 0.20 1</ambient><diffuse>0.65 0.48 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- Box                        -->
    <!-- ========================= -->
    <model name="box">
      <static>false</static>
      <pose>0.46 4.05 0.5 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- Turtle (simple proxy)      -->
    <!-- ========================= -->
    <model name="turtle">
      <static>true</static>
      <pose>-1.56 4.41 0.08 0 0 0</pose>

      <link name="shell">
        <collision name="collision">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.10 0.35 0.10 1</ambient><diffuse>0.15 0.45 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="head">
        <pose>0.13 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material><ambient>0.10 0.45 0.10 1</ambient><diffuse>0.15 0.60 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- Grey wall                  -->
    <!-- ========================= -->
    <model name="grey_wall">
      <static>true</static>
      <pose>8.48 2.43 0.6 0 0 1.57387</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.0 0.2 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

  </world>
</sdf>